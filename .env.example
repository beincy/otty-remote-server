# === Local Otty Server (main.py) ===
# Optional: if omitted, a persistent token & instance_id are generated in
# ~/.config/otty-server/instance.json (mode 0600) and printed on startup.
# OTTY_SERVER_TOKEN=replace-with-a-random-secret
# OTTY_INSTANCE_ID=inst_my_mac

# Gateway URL to connect outbound to (ws/wss or http/https):
OTTY_GATEWAY_URL=http://127.0.0.1:8020
OTTY_GATEWAY_REGISTER_KEY=replace-with-gateway-register-secret

# MCP is enabled automatically when connecting to gateway-cf. Startup prints
# the MCP URL, group keys and routes file. No extra local MCP token is generated.
# OTTY_MCP_ENABLED=0
# Optional: local permission ceiling, independent of permissions granted by groups.
# OTTY_MCP_PERMISSIONS=read,control,manage
# Local group routes (default: mcp-groups.json next to instance.json).
# OTTY_MCP_ROUTES_FILE=/absolute/path/mcp-groups.json

# Optional: also listen locally for LAN / local HTTP debugging (`--listen`):
# OTTY_SERVER_LISTEN=1
# OTTY_SERVER_HOST=127.0.0.1
# OTTY_SERVER_PORT=8000

# Optional: allow typing into plain shell tabs (= remote command execution). Off by default.
# OTTY_SERVER_ALLOW_SHELL_INPUT=1

# === Public Gateway (gateway.py) ===
# OTTY_GATEWAY_HOST=0.0.0.0
# OTTY_GATEWAY_PORT=8020
# OTTY_GATEWAY_CORS_ORIGINS=https://your-frontend.example
